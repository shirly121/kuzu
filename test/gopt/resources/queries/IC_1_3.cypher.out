PROJECTION[p2_id,p2_lastname,p2_birthday,p2_creationdate,p2_gender,p2_browserused,p2_locationip,pl_name]
HASH_JOIN[pl._ID, SIP: ON_BUILD, Join Type: INNER]
CHILD:
    FLATTEN[]
    SCAN_NODE_TABLE[pl._ID pl_name]
CHILD:
    SEMI_MASKER[pl._ID]
    PROJECTION[p2_id,pl._ID,p2_lastname,p2_browserused,p2_locationip,p2_birthday,p2_creationdate,p2_gender]
    EXTEND[p2-->pl]
    HASH_JOIN[p2._ID, SIP: ON_BUILD, Join Type: INNER]
    CHILD:
        FLATTEN[]
        FILTER[EQUALS(p2.p_firstName,Abdullah)]
        SCAN_NODE_TABLE[p2._ID p2_gender,p2_creationdate,p2_birthday,p2_locationip,p2_browserused,p2_lastname,p2.p_firstName,p2_id]
    CHILD:
        SEMI_MASKER[p2._ID]
        PROJECTION[p2._ID]
        EXTEND[<-->p2]
        EXTEND[<-->]
        EXTEND[p1<-->]
        SCAN_NODE_TABLE[p1._ID p1.p_personid PK_SCAN(933)]
