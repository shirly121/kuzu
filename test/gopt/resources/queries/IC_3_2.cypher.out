PROJECTION[p2_id,p2_firstname,p2_lastname]
HASH_JOIN[pl2._ID, SIP: ON_BUILD, Join Type: INNER]
CHILD:
    FLATTEN[]
    FILTER[EQUALS(pl2.pl_name,Germany)]
    SCAN_NODE_TABLE[pl2._ID pl2.pl_name]
CHILD:
    SEMI_MASKER[pl2._ID]
    PROJECTION[pl2._ID,p2_lastname,p2_id,p2_firstname]
    EXTEND[m2-->pl2]
    HASH_JOIN[m2._ID, SIP: ON_BUILD, Join Type: INNER]
    CHILD:
        FLATTEN[]
        FILTER[LESS_THAN(m2.m_creationDate,1301426799012)]
        FILTER[GREATER_THAN_EQUALS(m2.m_creationDate,1296242799012)]
        SCAN_NODE_TABLE[m2._ID m2.m_creationDate]
    CHILD:
        SEMI_MASKER[m2._ID]
        PROJECTION[p2_lastname,m2._ID,p2_id,p2_firstname]
        EXTEND[p2<--m2]
        HASH_JOIN[p1._ID, SIP: NONE, Join Type: INNER]
        CHILD:
            SCAN_NODE_TABLE[p1._ID p1.p_personid PK_SCAN(26388279067479)]
        CHILD:
            PROJECTION[p2_lastname,p2_id,p2_firstname,p1._ID,p2._ID]
            EXTEND[<-k1->p1]
            EXTEND[p2<-->]
            HASH_JOIN[p2._ID, SIP: ON_BUILD, Join Type: INNER]
            CHILD:
                FLATTEN[]
                SCAN_NODE_TABLE[p2._ID p2_firstname,p2_id,p2_lastname]
            CHILD:
                SEMI_MASKER[p2._ID]
                PROJECTION[p2._ID]
                EXTEND[m1-->p2]
                HASH_JOIN[m1._ID, SIP: ON_BUILD, Join Type: INNER]
                CHILD:
                    FLATTEN[]
                    FILTER[LESS_THAN(m1.m_creationDate,1301426799012)]
                    FILTER[GREATER_THAN_EQUALS(m1.m_creationDate,1296242799012)]
                    SCAN_NODE_TABLE[m1._ID m1.m_creationDate]
                CHILD:
                    SEMI_MASKER[m1._ID]
                    PROJECTION[m1._ID]
                    EXTEND[pl1<--m1]
                    FILTER[EQUALS(pl1.pl_name,Germany)]
                    SCAN_NODE_TABLE[pl1._ID pl1.pl_name]
